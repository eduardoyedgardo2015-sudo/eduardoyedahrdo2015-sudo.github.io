{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 19099
    },
    "functions": {
      "port": 15001
    },
    "firestore": {
      "port": 18080,
      "websocketPort": 19150
    },
    "hub": {
      "port": 14400
    },
    "logging": {
      "port": 14500
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
